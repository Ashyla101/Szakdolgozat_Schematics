(version 1)

(rule "IC1 local clearance"
    (condition "A.intersectsCourtyard('IC1') && B.intersectsCourtyard('IC1')")
    (constraint clearance (min 0.15mm))
)

(rule "IC3 local clearance"
    (condition "A.intersectsCourtyard('IC3') && B.intersectsCourtyard('IC3')")
    (constraint clearance (min 0.15mm))
)

# LTC4365: 0.20 mm pad gap, local pad-to-pad exception only.
# JLCPCB published SMD pad-to-pad minimum: 0.15 mm.
(rule "IC4 adjacent pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('IC4') && B.memberOfFootprint('IC4')")
  (constraint clearance (min 0.20mm))
)
